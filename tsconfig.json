{
  // convert.ts runs on Node, which strips types instead of compiling them:
  // only erasable syntax and explicit .ts imports. page.ts runs in the
  // browser, inlined by convert.ts.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["convert.ts", "page.ts"]
}
