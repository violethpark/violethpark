{
  "name": "violethpark-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "convert": "node convert.ts",
    "build-site": "node build-site.ts",
    "test": "node --test heading-link.test.ts",
    "typecheck": "tsc",
    "lint": "tsc -p config/lint/tsconfig.json && config/lint/node_modules/.bin/eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 --config config/lint/eslint.config.ts .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pyright": "pyright",
    "ruff": ".venv-fonts/bin/ruff check && .venv-fonts/bin/ruff format --check"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "3.9.10",
    "pyright": "1.1.414",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "marked": "^18.1.2"
  }
}
