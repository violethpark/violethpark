from fontTools.ttLib import TTFont

class Options:
    drop_tables: list[str]
    flavor: str | None
    def __init__(self, *, flavor: str | None = ...) -> None: ...

class Subsetter:
    def __init__(self, options: Options | None = ...) -> None: ...
    def populate(self, *, text: str = ...) -> None: ...
    def subset(self, font: TTFont) -> None: ...

def load_font(fontFile: str, options: Options) -> TTFont: ...
def save_font(font: TTFont, outfile: str, options: Options) -> None: ...
