flowchart TB
  accTitle: Repository publishing structure
  accDescr: RESUME*.md is the factual source for the CV in three languages, which the README profiles summarize. convert.ts, with the heading links of heading-link.ts and the page script page.ts, turns CV*.md into CV*.html locally and in the deploy workflow; the workflow adds style.css, images, and the fonts cut to the pages' characters (subset-fonts.py) with build-site.ts and deploys the site to GitHub Pages at about.violethpark.com.
  subgraph local ["Local only (gitignored)"]
    html["CV*.html<br/>local build"]
    resume["RESUME*.md<br/>source resume, Korean"]
  end
  subgraph repo [Repository]
    cv["CV*.md<br/>CV: en, ko, jp"]
    readme["README*.md<br/>profile: en, ko, jp"]
    assets["style.css, images/<br/>fonts/, subset-fonts.py"]
    convert["convert.ts, page.ts<br/>heading-link.ts<br/>marked, CV*.md to CV*.html"]
    workflow["deploy-cv.yml<br/>.github/workflows/"]
  end
  subgraph github [GitHub]
    run["Actions run (deploy-cv.yml)<br/>npm ci, typecheck, npm run convert, build-site.ts to _site/"]
    profile["GitHub profile<br/>github.com/violethpark"]
    pages["GitHub Pages<br/>about.violethpark.com<br/>/, /en/, /ko/, /jp/"]
  end
  resume -- "TASK.md 2" --> cv
  cv -- "summary, TASK.md 3" --> readme
  readme -- "README.md shown" --> profile
  cv --> convert
  convert -- "npm run convert" --> html
  assets -- "copied, fonts cut" --> run
  convert -- "npm run convert" --> run
  workflow -- "push to main, watched paths" --> run
  run -- deploy --> pages
